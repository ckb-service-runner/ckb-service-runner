// CSR on-chain data. Self-contained (no import of blockchain.mol).
// Regenerate: scripts/gen-schemas.sh

array Byte32 [byte; 32];
array Byte33 [byte; 33];
array Signature [byte; 65];
array Uint32 [byte; 4];
array Uint64 [byte; 8];
vector Bytes <byte>;
vector Byte32Vec <Byte32>;

// --- registry ---------------------------------------------------------------

// Out point of a live cell (same layout as `OutPoint` in blockchain.mol).
struct OutPoint {
    tx_hash: Byte32,
    index:   Uint32,
}

vector OutPointVec <OutPoint>;

// Fields signed by the monitor (`CSR-ATTEST-v2`, decision D21 A):
// message = blake2b_ckb("CSR-ATTEST-v2" ‖ molecule(AttestationBodyV2)). `expiry_ms` is the attestation expiry,
// `stake` the registry cell's stake, `registry_type_hash` the hash of the registry cell's own type script.
table AttestationBodyV2 {
    peer_id:            Bytes,
    service_pubkey:     Byte33,
    network:            byte,
    expiry_ms:          Uint64,
    stake:              OutPoint,
    registry_type_hash: Byte32,
}

// Registry cell data v3 (decision D20 A). The attestation is not a nested copy: the monitor signs the
// cell's own `peer_id`, `service_pubkey`, `network`, `expiry_ms` and `stake` (plus the registry type hash).
table RegistryV3 {
    version:          byte,         // 3
    peer_id:          Bytes,
    service_pubkey:   Byte33,
    payout_lock_hash: Byte32,       // lock hash of the operator's payout cell
    network:          byte,         // 0 mainnet, 1 testnet, 2 devnet
    stake:            OutPoint,     // the operator's Nervos DAO deposit cell
    expiry_ms:        Uint64,       // attestation expiry (monitor clock, ms)
    attestation_sig:  Signature,    // r ‖ s ‖ recid by the monitor over AttestationBodyV2
    endpoint:         Bytes,        // UTF-8 "https://host:port" / "http://host:port", may be empty, ≤ 128 bytes
    prekeys:          Bytes,
}

// --- job --------------------------------------------------------------------

table OnDemand {}
table AtBlock {
    block: Uint64,
}
table AtEpoch {
    epoch: Uint64,
}            // packed epoch number as in CKB `since`
table AtTimestamp {
    timestamp_ms: Uint64,
}
table Every {
    blocks: Uint64,
}

union Trigger {
    OnDemand,
    AtBlock,
    AtEpoch,
    AtTimestamp,
    Every,
}

table Job {
    trigger:          Trigger,
    tip_shannons:     Uint64,
    max_fee_shannons: Uint64,
    max_cycles:       Uint64,
    payload:          Bytes,
    expiry_block:     Uint64,
    refund_lock_hash: Byte32,
    remaining_runs:   Uint32,
}

// --- service manifest -------------------------------------------------------

// Data of a `csr-service-manifest` cell (spec/service-manifest.md).
table ServiceManifestV1 {
    version_tag:  byte,        // 1
    code_hash:    Byte32,      // data hash of the program (data2)
    code_cell:    OutPoint,    // where the program lives
    data_hashes:  Byte32Vec,   // 0..4 data cells, in cell-dep order
    data_cells:   OutPointVec, // same length and order as data_hashes
    args:         Bytes,       // 0..64 bytes, passed as the service script args
    name:         Bytes,       // UTF-8, 1..48 bytes
    version:      Bytes,       // UTF-8, 1..16 bytes, e.g. "1.0.0"
    description:  Bytes,       // UTF-8, 0..512 bytes, plain text
    url:          Bytes,       // empty or https:// URL, <= 128 bytes
    source:       Bytes,       // empty or https:// URL (e.g. GitHub), <= 128 bytes
    language:     Bytes,       // UTF-8, <= 16 bytes ("rust", "c", "js", ...)
    min_csr:      Bytes,       // empty or "X.Y.Z", the first runner version that can run it
    deprecated:   byte,        // 0 or 1
}
